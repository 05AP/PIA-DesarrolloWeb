        {
          "name": "Generar Arqueo y Corte de Turno (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Contiene resumen de transacciones\", function () { pm.expect(data).to.have.property('total_transacciones'); });",
                  "pm.test(\"Contiene diagnóstico de cuadre\", function () { pm.expect(data).to.have.property('cuadre_status'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{supervisor_token}}"}],
            "url": {"raw": "{{base_url}}/operaciones/corte", "host": ["{{base_url}}"], "path": ["operaciones", "corte"]}
