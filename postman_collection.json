            "body": {
              "mode": "raw",
              "raw": "{\n  \"tanque_id\": 1,\n  \"folio_remision\": \"REM-POSTMAN-{{$timestamp}}\",\n  \"proveedor\": \"PEMEX Refinación\",\n  \"litros_recibidos\": 3000.0,\n  \"costo_compra_litro\": 20.80,\n  \"notas\": \"Prueba automatizada desde Postman\"\n}"
            },
            "url": {"raw": "{{base_url}}/operaciones/suministro/recepcion-pipa", "host": ["{{base_url}}"], "path": ["operaciones", "suministro", "recepcion-pipa"]}
          }
        },
        {
          "name": "Recepción Rechazada por Sobrecupo / Derrame (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 400 Bad Request\", function () { pm.response.to.have.status(400); });"
