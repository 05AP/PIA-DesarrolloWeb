# Configuración General del Entorno
PROJECT_NAME="Gasolinera API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
# development | production  (en production se exige un SECRET_KEY propio de 32+ caracteres)
ENVIRONMENT="development"
# True imprime cada consulta SQL en consola (útil solo para depurar)
DEBUG=False

# Configuración de Base de Datos
# SQLite local:   sqlite:///./gasolinera.db
# PostgreSQL:     postgresql://usuario:password@host:5432/gasolinera
DATABASE_URL="sqlite:///./gasolinera.db"

# Seguridad y Autenticación JWT
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="cambia_esta_clave_por_una_generada_aleatoriamente"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes externos permitidos por CORS (formato JSON). El frontend integrado no lo necesita.
# BACKEND_CORS_ORIGINS='["http://localhost:5173"]'

# Usuario Administrador Inicial (Seed Data)
FIRST_SUPERUSER_EMAIL="admin@gasolinera.com"
FIRST_SUPERUSER_PASSWORD="admin123"
FIRST_SUPERUSER_NAME="Administrador General"

# Crear usuarios demo (supervisor/despachador), tanques, bombas y ventas de ejemplo
SEED_DEMO_DATA=True
